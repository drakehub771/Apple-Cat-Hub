-- ============================================
-- FUNÇÕES DO AUTO FARM (VOO + MISSÃO + FARM)
-- ============================================
local function flyToPosition(targetCFrame)
    if not getgenv().Config["Auto Turn On Buso"] then return end
    
    local targetPos = targetCFrame.Position + addJitter()
    local distance = (rootPart.Position - targetPos).Magnitude
    
    if distance > 5 then
        local direction = (targetPos - rootPart.Position).Unit
        local speed = 70 + (math.random() - 0.5) * 10
        
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 80000
        bodyVelocity.Velocity = direction * speed
        bodyVelocity.Parent = rootPart
        
        rootPart.CFrame = CFrame.new(rootPart.Position, targetPos)
        
        task.wait(randomDelay(0.8, 1.2))
        bodyVelocity:Destroy()
        checkVelocity()
    end
end

local function getMission()
    local island = getCurrentIsland()
    if not island then return end
    
    local npcQuest = nil
    for _, npc in pairs(Workspace.NPCs:GetChildren()) do
        if npc.Name:find(island.MissaoNPC) and npc:FindFirstChild("HumanoidRootPart") then
            npcQuest = npc
            break
        end
    end
    
    if npcQuest then
        flyToPosition(npcQuest.HumanoidRootPart.CFrame)
        task.wait(randomDelay(0.5, 0.8))
        
        VirtualInputManager:SendMouseButtonEvent(npcQuest.HumanoidRootPart.Position, 0, true, game, 0)
        task.wait(randomDelay(0.1, 0.2))
        VirtualInputManager:SendMouseButtonEvent(npcQuest.HumanoidRootPart.Position, 0, false, game, 0)
        
        task.wait(randomDelay(1, 1.5))
        humanLikeBehavior()
    end
end

local function findTarget()
    local island = getCurrentIsland()
    if not island then return nil end
    
    local closestNPC = nil
    local shortestDist = 30
    
    for _, npc in pairs(Workspace.Enemies:GetChildren()) do
        if npc.Name:find(island.MissaoNPC) and npc:FindFirstChild("HumanoidRootPart") and npc.Humanoid.Health > 0 then
            local dist = (rootPart.Position - npc.HumanoidRootPart.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                closestNPC = npc
            end
        end
        task.wait()
    end
    
    return closestNPC
end

local function attackNPC(npc)
    if not npc or not npc:FindFirstChild("HumanoidRootPart") then return end
    
    local npcHRP = npc.HumanoidRootPart
    local headPos = npcHRP.CFrame * CFrame.new(0, 4 + math.random() * 0.5, 0)
    flyToPosition(headPos)
    
    task.wait(randomDelay(0.1, 0.3))
    
    -- Usar habilidades conforme configuração
    local tool = character:FindFirstChildOfClass("Tool") or player.Backpack:FindFirstChildOfClass("Tool")
    if tool then
        if player.Backpack:FindFirstChild(tool.Name) then
            player.Backpack[tool.Name].Parent = character
        end
        
        -- Usar skills configuradas
        if getgenv().Config["Select Weapons Use Skill"]["Sword"] and tool.ToolTip == "Sword" then
            for skill, enabled in pairs(getgenv().Config["Select Skills Sword"]) do
                if enabled then
                    VirtualInputManager:SendKeyEvent(true, skill, false, game)
                    task.wait(randomDelay(0.05, 0.1))
                    VirtualInputManager:SendKeyEvent(false, skill, false, game)
                end
            end
        end
        
        -- Cliques M1
        if getgenv().Config["Auto Click"] then
            for i = 1, math.random(2, 4) do
                VirtualInputManager:SendMouseButtonEvent(npcHRP.Position, 0, true, game, 0)
                task.wait(randomDelay(0.05, 0.1))
                VirtualInputManager:SendMouseButtonEvent(npcHRP.Position, 0, false, game, 0)
                task.wait(randomDelay(0.15, 0.25))
            end
        end
    end
    
    if math.random(1, 100) > 90 then
        task.wait(randomDelay(0.3, 0.8))
    end
end

