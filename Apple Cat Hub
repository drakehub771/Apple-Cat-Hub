for _, loc in ipairs(teleportLocations) do
    AddButton("Teleportar para " .. loc[1], function()
        pcall(function()
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj.Name == loc[2] or string.find(obj.Name, loc[2]) then
                    if obj:IsA("Part") or obj:IsA("BasePart") then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(obj.Position + Vector3.new(0, 5, 0))
                        break
                    elseif obj:IsA("Model") then
                        local primary = obj.PrimaryPart or obj:FindFirstChild("Part")
                        if primary then
                            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(primary.Position + Vector3.new(0, 5, 0))
                            break
                        end
                    end
                end
            end
        end)
    end)
end

