-- Função para criar label
local function AddLabel(text)
    local lbl = Instance.new("TextLabel")
    lbl.Parent = scroll
    lbl.Size = UDim2.new(1, -10, 0, 24)
    lbl.Position = UDim2.new(0, 5, 0, y)
