-- ============================================
-- SISTEMA AIMBOT
-- ============================================
local AimbotActive = false

local function GetBestTarget()
    local ScreenCenter = Camera.ViewportSize / 2
    local BestDist = Config.FOVRadius
    local BestPlayer = nil
    local BestHeadPos = nil
    
    for _, Player in pairs(Players:GetPlayers()) do
        if IsValidTarget(Player) then
            local HeadPos = GetHeadPosition(Player)
            if HeadPos then
                local ScreenPos, OnScreen = Camera:WorldToViewportPoint(HeadPos)
                if OnScreen then
                    local DistToCenter = (Vector2.new(ScreenPos.X, ScreenPos.Y) - ScreenCenter).Magnitude
                    local WorldDist = GetDistance(Player)
                    
                    if DistToCenter < BestDist and WorldDist < Config.MaxDistance then
                        BestDist = DistToCenter
                        BestPlayer = Player
                        BestHeadPos = HeadPos
                    end
                end
            end
        end
    end
    
    return BestPlayer, BestHeadPos
end

local function SmoothAim(TargetPos)
    if not TargetPos then return end
    local Current = Camera.CFrame
    local Target = CFrame.lookAt(Current.Position, TargetPos)
    local New = Current:Lerp(Target, Config.Smoothness)
    Camera.CFrame = New
end

