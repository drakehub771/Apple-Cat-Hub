AddToggle("Fast Attack", function(checkEnabled)
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local args = {...}
        local method = getnamecallmethod()
        
        if checkEnabled() and method == "InvokeServer" and self.Name == "RemoteEvent" then
            if args[1] == "KeyPressed" or args[1] == "Attack" then
                for i = 1, 2 do
                    task.spawn(function()
                        return oldNamecall(self, unpack(args))
                    end)
                end
                return
            end
        end
        
        return oldNamecall(self, ...)
    end)
end)

