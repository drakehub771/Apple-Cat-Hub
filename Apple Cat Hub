-- Anti Ban System
local function antiBanSystem()
    spawn(function()
        while true do
            wait()
            pcall(function()
                for _, v in pairs(game:GetDescendants()) do
                    if v:IsA("Script") and (string.find(v.Name, "Anti") or string.find(v.Name, "Detection") or string.find(v.Name, "Ban")) then
                        v:Destroy()
                    end
                end
                
                if LocalPlayer.Idled then
                    VirtualUser:Button2Down(Vector2.new(0, 0), Workspace.CurrentCamera.CFrame)
                    wait(1)
                    VirtualUser:Button2Up(Vector2.new(0, 0), Workspace.CurrentCamera.CFrame)
                end
            end)
            wait(30)
        end
    end)
end

