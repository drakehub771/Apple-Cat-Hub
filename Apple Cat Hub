-- Elementos da GUI
local yOffset = 0
local function AddButton(text, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = ContentArea
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.Position = UDim2.new(0, 5, 0, yOffset)
    btn.Text = text
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    btn.BackgroundTransparency = 0.1
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = isMobile and 12 or 14
    btn.BorderSizePixel = 0
    
    if callback then
        btn.MouseButton1Click:Connect(callback)
        btn.TouchTap:Connect(callback)
    end
    
    yOffset = yOffset + 40
    ContentArea.CanvasSize = UDim2.new(0, 0, 0, yOffset + 50)
    return btn
end

local function AddLabel(text)
    local lbl = Instance.new("TextLabel")
    lbl.Parent = ContentArea
    lbl.Size = UDim2.new(1, -10, 0, 25)
    lbl.Position = UDim2.new(0, 5, 0, yOffset)
    lbl.Text = text
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = isMobile and 12 or 14
    
    yOffset = yOffset + 30
    ContentArea.CanvasSize = UDim2.new(0, 0, 0, yOffset + 50)
    return lbl
end

-- Toggle automático
local function AddToggle(text, enabledCallback, disabledCallback)
    local enabled = false
    local btn = AddButton(text .. ": OFF", function()
        enabled = not enabled
        if enabled then
            btn.Text = text .. ": ON"
            btn.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
            if enabledCallback then
                enabledCallback(function() return enabled end)
            end
        else
            btn.Text = text .. ": OFF"
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            if disabledCallback then
                disabledCallback()
            end
        end
    end)
    return btn
end

