-- Função para criar botão com suporte mobile
local function createButton(parent, text, position, size, callback)
    local button = Instance.new("TextButton")
    button.Parent = parent
    button.Text = text
    button.Position = position
    button.Size = size
    button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextSize = isMobile and 12 or 14
    button.BorderSizePixel = 0
    button.BackgroundTransparency = 0.2
    button.Font = Enum.Font.Gotham
    
    -- Suporte para toque e clique
    button.MouseButton1Click:Connect(callback)
    button.TouchTap:Connect(callback)
    
    return button
end

-- Função para teleporte seguro
local function safeTeleport(position)
    pcall(function()
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(position)
        end
    end)
end

-- Função para encontrar e teleportar para local
local function teleportToLocation(locationName)
    pcall(function()
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj.Name == locationName or string.find(obj.Name, locationName) then
                if obj:IsA("Part") or obj:IsA("BasePart") then
                    safeTeleport(obj.Position + Vector3.new(0, 5, 0))
                    return true
                elseif obj:IsA("Model") then
                    local primary = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Part")
                    if primary then
                        safeTeleport(primary.Position + Vector3.new(0, 5, 0))
                        return true
                    end
                end
            end
        end
    end)
    return false
end

