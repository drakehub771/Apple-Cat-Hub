-- Aimbot para PC
local PC_Aiming = false

if not UserInputService.TouchEnabled then
    UserInputService.InputBegan:Connect(function(Input, Processed)
        if Processed then return end
        if Config.Aimbot and Input.UserInputType == Enum.UserInputType.MouseButton2 then
            PC_Aiming = true
            while PC_Aiming and Config.Aimbot do
                local _, HeadPos = GetBestTarget()
                if HeadPos then
                    SmoothAim(HeadPos)
                end
                task.wait()
            end
        end
    end)
    
    UserInputService.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton2 then
            PC_Aiming = false
        end
    end)
end

