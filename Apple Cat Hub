-- ============================================
-- SISTEMA ANTI-BAN
-- ============================================
local AntiBan = {
    Ativo = true,
    VelocidadeMaxima = 70,
    UltimoCheck = tick(),
}

local function randomDelay(min, max)
    return min + math.random() * (max - min)
end

local function addJitter()
    return Vector3.new((math.random() - 0.5) * 0.5, 0, (math.random() - 0.5) * 0.5)
end

local function humanLikeBehavior()
    if math.random(1, 100) > 95 then
        task.wait(randomDelay(0.1, 0.3))
    end
end

local function checkVelocity()
    if not AntiBan.Ativo then return end
    local currentVel = rootPart.Velocity.Magnitude
    if currentVel > AntiBan.VelocidadeMaxima then
        rootPart.Velocity = rootPart.Velocity.Unit * AntiBan.VelocidadeMaxima
    end
end

