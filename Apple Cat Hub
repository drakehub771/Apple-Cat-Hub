end

-- Loop principal de renderização
RunService.RenderStepped:Connect(function()
    -- Atualizar FOV
    if Config.FOV then
        FOVContainer.Visible = true
        Crosshair.Visible = true
        DotCenter.Visible = true
        if MobileAimbotBtn then MobileAimbotBtn.Visible = true end
    else
        FOVContainer.Visible = false
        Crosshair.Visible = false
        DotCenter.Visible = false
        if MobileAimbotBtn then MobileAimbotBtn.Visible = false end
    end
    
    -- Atualizar ESP
    if Config.ESP then
        for _, Player in pairs(Players:GetPlayers()) do
            if IsValidTarget(Player) then
                if not ESPObjects[Player] then
                    CreateESP(Player)
                end
                
                local HeadPos = GetHeadPosition(Player)
                if HeadPos then
                    local ScreenPos, OnScreen = Camera:WorldToViewportPoint(HeadPos)
                    if OnScreen then
                        local Distance = GetDistance(Player)
                        local BoxSize = math.clamp(120 * (35 / Distance), 40, 110)
                        
                        local ESP = ESPObjects[Player]
                        ESP.Box.Size = UDim2.new(0, BoxSize, 0, BoxSize)
                        ESP.Box.Position = UDim2.new(0, ScreenPos.X - BoxSize/2, 0, ScreenPos.Y - BoxSize/1.5)
                        ESP.Box.Visible = true
                        
                        ESP.Name.Position = UDim2.new(0, ScreenPos.X - 70, 0, ScreenPos.Y - BoxSize/1.5 - 25)
                        ESP.Name.Visible = true
                        
                        ESP.Distance.Text = math.floor(Distance) .. "m"
                        ESP.Distance.Position = UDim2.new(0, ScreenPos.X - 35, 0, ScreenPos.Y + BoxSize/2 + 5)
                        ESP.Distance.Visible = true
                        
                        ESP.HeadDot.Position = UDim2.new(0, ScreenPos.X - 3, 0, ScreenPos.Y - 3)
                        ESP.HeadDot.Visible = true
                    else
                        if ESPObjects[Player] then
                            ESPObjects[Player].Box.Visible = false
                            ESPObjects[Player].Name.Visible = false
                            ESPObjects[Player].Distance.Visible = false
                            ESPObjects[Player].HeadDot.Visible = false
                        end
                    end
                end
            elseif ESPObjects[Player] then
                RemoveESP(Player)
            end
        end
    else
        for Player, _ in pairs(ESPObjects) do
            RemoveESP(Player)
        end
    end
end)

