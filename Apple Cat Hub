local function startAutoFarmSystem()
    if autoFarmThread then return end
    autoFarmRunning = true
    autoFarmThread = task.spawn(autoFarmLoop)
end

local function stopAutoFarmSystem()
    autoFarmRunning = false
    if autoFarmThread then
        task.cancel(autoFarmThread)
        autoFarmThread = nil
    end
end

-- Controle do Start Farm
local function checkStartFarm()
    if getgenv().Config["Start Farm"] then
        startAutoFarmSystem()
        statusIcon.Text = "ON"
        statusIcon.TextColor3 = Color3.fromRGB(0, 255, 0)
        toggleButton.BackgroundColor3 = Color3.fromRGB(220, 20, 60)
    else
        stopAutoFarmSystem()
        statusIcon.Text = "OFF"
        statusIcon.TextColor3 = Color3.fromRGB(255, 0, 0)
        toggleButton.BackgroundColor3 = Color3.fromRGB(100, 100, 110)
    end
end

-- Monitorar mudança no Start Farm
local function monitorConfig()
    local lastState = getgenv().Config["Start Farm"]
    while true do
        task.wait(0.5)
        if getgenv().Config["Start Farm"] ~= lastState then
            lastState = getgenv().Config["Start Farm"]
            checkStartFarm()
        end
    end
end

