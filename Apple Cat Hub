-- Função para trocar aba
local function switchTab(tabName)
    for n, tab in pairs(tabs) do
        tab.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        tab.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
    for n, cont in pairs(contents) do
        cont.Visible = false
    end
    if tabs[tabName] then
        tabs[tabName].BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        tabs[tabName].TextColor3 = Color3.fromRGB(255, 255, 255)
    end
    if contents[tabName] then
        contents[tabName].Visible = true
    end
end

-- Conectar abas
for name, tab in pairs(tabs) do
    tab.Activated:Connect(function()
        switchTab(name)
    end)
end

-- Funções auxiliares
local function createToggle(parent, text, yPos, callback)
    local enabled = false
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.Size = UDim2.new(1, -10, 0, 36)
    btn.Position = UDim2.new(0, 5, 0, yPos)
    btn.Text = "  " .. text .. ": OFF"
    btn.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    btn.BackgroundTransparency = 0.15
    btn.TextColor3 = Color3.fromRGB(180, 180, 180)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.BorderSizePixel = 0
    
    btn.Activated:Connect(function()
        enabled = not enabled
        if enabled then
            btn.Text = "  " .. text .. ": ON"
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            if callback then callback(true, function() return enabled end) end
        else
            btn.Text = "  " .. text .. ": OFF"
            btn.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
            btn.TextColor3 = Color3.fromRGB(180, 180, 180)
            if callback then callback(false) end
        end
    end)
    return btn
end

local function createButton(parent, text, yPos, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.Size = UDim2.new(1, -10, 0, 36)
    btn.Position = UDim2.new(0, 5, 0, yPos)
    btn.Text = "  " .. text
    btn.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    btn.BackgroundTransparency = 0.15
    btn.TextColor3 = Color3.fromRGB(180, 180, 180)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.BorderSizePixel = 0
    
    btn.Activated:Connect(callback)
    return btn
end

