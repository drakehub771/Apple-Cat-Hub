AddToggle("Fast Attack", function(on, check)
    if on then
        local old
        old = hookmetamethod(game, "__namecall", function(self, ...)
            local args = {...}
            local method = getnamecallmethod()
            if check() and method == "InvokeServer" and self.Name == "RemoteEvent" then
                if args[1] == "KeyPressed" or args[1] == "Attack" then
                    for i = 1, 2 do
                        task.spawn(function() return old(self, unpack(args)) end)
                    end
                    return
                end
            end
            return old(self, ...)
        end)
    end
end)

