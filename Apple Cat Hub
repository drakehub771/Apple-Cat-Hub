-- ============================================
-- LOOP PRINCIPAL DO AUTO FARM
-- ============================================
local autoFarmRunning = true
local autoFarmThread = nil

local function autoFarmLoop()
    while autoFarmRunning do
        local success, err = pcall(function()
            if not getgenv().Config["Start Farm"] then return end
            
            humanLikeBehavior()
            
            if humanoid.Health <= 0 then
                task.wait(randomDelay(4, 6))
                character = player.Character or player.CharacterAdded:Wait()
                humanoid = character:WaitForChild("Humanoid")
                rootPart = character:WaitForChild("HumanoidRootPart")
            end
            
            local island = getCurrentIsland()
            if island and (rootPart.Position - island.CFrame.Position).Magnitude > 100 then
                flyToPosition(island.CFrame)
                task.wait(randomDelay(1, 1.5))
            end
            
            local hasMission = false
            pcall(function()
                if player.PlayerGui.ScreenGui.Quest.Visible then
                    hasMission = true
                end
            end)
            
            if not hasMission then
                getMission()
                task.wait(randomDelay(1.5, 2))
            end
            
            local target = findTarget()
            if target then
                attackNPC(target)
            else
                task.wait(randomDelay(0.5, 1.5))
            end
        end)
        
        if not success then
            task.wait(randomDelay(1, 2))
        end
        
        task.wait(randomDelay(0.4, 0.6))
    end
end

