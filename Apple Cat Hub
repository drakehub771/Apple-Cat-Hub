            child:Destroy()
        end
    end
    
    local currentIslands = islands[selectedSea] or {}
    islandScroll.CanvasSize = UDim2.new(0, 0, 0, #currentIslands * 30)
    
    for i, island in ipairs(currentIslands) do
        local islandBtn = Instance.new("TextButton")
        islandBtn.Parent = islandScroll
        islandBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        islandBtn.BackgroundTransparency = 0.2
        islandBtn.Size = UDim2.new(1, -10, 0, 28)
        islandBtn.Position = UDim2.new(0, 5, 0, (i-1) * 30)
        islandBtn.Text = island
        islandBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        islandBtn.TextSize = 11
        islandBtn.BorderSizePixel = 0
        
        islandBtn.MouseButton1Click:Connect(function()
            selectedIsland = island
            islandDropdown.Text = "Ilha: " .. island
            islandList.Visible = false
        end)
    end
end

